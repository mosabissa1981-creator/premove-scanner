{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/save-gex",
      "schedule": "0 21 * * 1-5"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cursor/*": false
    }
  },
  "github": {
    "silent": true
  }
}
