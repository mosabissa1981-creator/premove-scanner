generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HistoricalGEX {
  id         String   @id @default(cuid())
  symbol     String
  date       String
  gammaFlip  Float?
  putWall    Float?
  callWall   Float?
  spotPrice  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol, date])
}
