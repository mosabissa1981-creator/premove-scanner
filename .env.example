# Unusual Whales API (server-side fallback; users can also paste in Settings)
UNUSUAL_WHALES_API_KEY=

# Historical GEX snapshots (SQLite file path or Postgres URL)
DATABASE_URL="file:./prisma/dev.db"

# Cron auth for /api/cron/save-gex (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Alert webhooks (optional — at least one enables proximity alerts)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public app URL for alert deep links
NEXT_PUBLIC_APP_URL=

# Scorch Hot Cloudflare Worker only (web push)
# VAPID_PUBLIC_KEY=
